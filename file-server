//server

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <signal.h>
#include <arpa/inet.h>

int main() {
    signal(SIGCHLD, SIG_IGN); // Prevent zombie processes
    int sfd = socket(AF_INET, SOCK_STREAM, 0), cfd;
    struct sockaddr_in addr = {AF_INET, htons(8080), INADDR_ANY};
    char buf[1024];

    bind(sfd, (struct sockaddr *)&addr, sizeof(addr));
    listen(sfd, 5);
    printf("File Server Running...\n");

    while ((cfd = accept(sfd, NULL, NULL))) {
        if (fork() == 0) {
            close(sfd);
            int n = recv(cfd, buf, sizeof(buf) - 1, 0);
            buf[n] = '\0';

            FILE *fp = fopen(buf, "r");
            dprintf(cfd, "Server PID: %d\n\n", getpid()); // Formats & sends directly to socket

            if (!fp)
                send(cfd, "Requested file does not exist.\n", 31, 0);
            else {
                while (fgets(buf, sizeof(buf), fp))
                    send(cfd, buf, strlen(buf), 0);
                fclose(fp);
            }
            close(cfd);
            return 0;
        }
        close(cfd);
    }
}





//client

#include <stdio.h>
#include <string.h>
#include <unistd.h>
#include <arpa/inet.h>

int main() {
    int sfd = socket(AF_INET, SOCK_STREAM, 0), n;
    struct sockaddr_in addr = {AF_INET, htons(8080), inet_addr("127.0.0.1")};
    char buf[1024];

    connect(sfd, (struct sockaddr *)&addr, sizeof(addr));
    printf("Enter filename: ");
    scanf("%s", buf);
    send(sfd, buf, strlen(buf), 0);

    printf("\nResponse from Server:\n\n");
    while ((n = recv(sfd, buf, sizeof(buf) - 1, 0)) > 0) {
        buf[n] = '\0';
        printf("%s", buf);
    }
    close(sfd);
    return 0;
}
